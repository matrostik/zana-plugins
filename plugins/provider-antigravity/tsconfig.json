{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["app.tsx", "host.ts", "server.ts", "src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test-environment.ts"]
}
